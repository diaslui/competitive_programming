typedef long long ll;
#define _ ios_base::sync_with_stdio(0);cin.tie(0);
const int INF = 0x3f3f3f3f;
const ll LINF = 0x3f3f3f3f3f3f3f3fll;
const int MOD = 1e9 + 7;

#define fi first
#define se second
#define pb push_back
#define sz size

using pii = pair<int, int>;
using vi = vector<int>;
using vvi = vector<vi>;

#define endl "\n"
#define dbg(x) cout << #x << " = " << x << "\n";
#define all(x) x.begin(), x.end()

const int MAXN = 10000;

void solve(){

   int a, b; cin >> a >> b;
   
   int pref[MAXN + 1];
   pref[0] = 0;
   for (int i=1; i <= MAXN; i++) pref[i] = pref[i-1] + i; 

   int ans = 0;
   for (int i=a; i > 0; i--){
      if (pref[a - i] - i == b){
         ans = i; break;
      }
   }

   cout << ans << endl;
   }

int main(){_
   int t = 1;
   while (t--) solve();
   return 0;
}

